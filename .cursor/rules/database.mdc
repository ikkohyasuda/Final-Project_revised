## 🔧 データベース接続設定

```python
# database.py
from peewee import *
from datetime import datetime

# SQLite データベース接続
db = SqliteDatabase('medication_checker.db')

class BaseModel(Model):
    """ベースモデル：全モデルの共通設定"""
    class Meta:
        database = db

def initialize_database():
    """データベース初期化"""
    db.connect()
    db.create_tables([
        Medicine,
        SideEffect,
        MedicineSideEffect,
        UploadedImage,
        ExtractedMedicine,
        MatchedMedicine,
        CheckedSymptom,
        SummarySheet
    ])
    
def close_database():
    """データベース接続を閉じる"""
    if not db.is_closed():
        db.close()
```

