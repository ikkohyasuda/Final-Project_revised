    generic_name="ロキソプロフェンナトリウム水和物",
    drug_category="解熱鎮痛薬",
    caution_reason="消化管出血、腎機能低下、心血管系イベントリスク増加",
    reference_source="高齢者の安全な薬物療法ガイドライン2015"
)

# 副作用症状の作成
side_effect = SideEffect.create(
    symptom_name="めまい",
    symptom_description="立ちくらみやバランスを崩しやすくなる症状。転倒の原因となります。"
)

# 関連付け
relation = MedicineSideEffect.create(
    medicine=medicine,
    side_effect=side_effect,
    frequency_note="時々ある（1-5%）"
)
```

### データの取得

```python
# 薬剤名での検索（部分一致）
medicines = Medicine.select().where(
    Medicine.medicine_name.contains("ロキソニン")
)

# 画像の抽出結果を取得（リレーション使用）
image = UploadedImage.get_by_id(1)
extracted_medicines = image.extracted_medicines

# 該当薬剤の副作用リストを取得
medicine = Medicine.get_by_id(1)
side_effects = (SideEffect
    .select()
    .join(MedicineSideEffect)
    .where(MedicineSideEffect.medicine == medicine)
)
```

### トランザクション処理

```python
from peewee import database

# トランザクション開始
with db.atomic():
    # 画像アップロード
    image = UploadedImage.create(
        file_path="uploads/2026/01/prescription.jpg",
        file_format="JPEG",
        file_size=2458624
    )
    
    # OCR抽出
    extracted = ExtractedMedicine.create(
        image=image,
        extracted_text="ロキソニン錠60mg"
    )
    
    # 照合
    matched = MatchedMedicine.create(
        extracted_medicine=extracted,
        medicine=medicine,
        is_matched=True
    )
```

